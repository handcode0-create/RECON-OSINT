      "include_subdomains": true,
      "mode": "authorized_lab",
      "allowed_sources": [],
      "dns_enabled": false,
      "active_http_enabled": false,
      "https_only": true,
      "max_results": 300,
      "max_hosts": 20,
      "timeout_seconds": 8
